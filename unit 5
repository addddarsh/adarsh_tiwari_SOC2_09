        cout<<"Parameterized constructor called in background"<<endl; }

    // Copy constructor: creates a new book as a copy of an existing one
    Book(const Book &b)
    {
        id = b.id;           // copy ID from the other book
        nm = b.nm;           // copy name from the other book
        price = b.price;     // copy price from the other book
        cout<<"Copy constructor called in background"<<endl;  }

